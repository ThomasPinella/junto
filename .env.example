# Junto environment configuration.
# Copy to .env.local and fill in real values; placeholders only in this file.
# Never commit credentials or real member data.

# Absolute URL the site is served from.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slug of the chapter whose publication `/` serves. Chapter pages themselves
# live under /juntos/[juntoSlug]; this only selects the initial homepage.
JUNTO_INITIAL_JUNTO_SLUG=philadelphia

# Supabase project URL and publishable/legacy anon key. Use the values printed
# by `pnpm db:start` locally and the hosted project's values in Railway.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# These four variables are the complete application environment. The app must
# never receive a Supabase service-role/secret key. Privileged test fixtures use
# only the well-known local CLI key inside loopback-guarded harness code.
